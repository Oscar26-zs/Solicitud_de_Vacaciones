@model DetalleSolicitudViewModel
@{
    ViewData["Title"] = "Detalle de Solicitud";
    var sol = Model.Solicitud;
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div class="flex items-center gap-3">
            <h1 class="mono">SOL-@sol.Id.ToString("N").Substring(0, 6).ToUpper()</h1>
            @await Html.PartialAsync("_StatusBadge", sol.Estado)
        </div>
        <a class="btn btn--outline" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Volver a bandeja
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Información de la solicitud</h2>
            </div>
            <div class="card-content flex flex-col gap-4">
                <div class="flex items-center gap-3">
                    @await Html.PartialAsync("_UserAvatar", (GetIniciales(sol.EmpleadoNombre), GetAvatarColor(sol.EmpleadoNombre)), new ViewDataDictionary(ViewData) { ["AvatarSize"] = "lg" })
                    <div class="flex flex-col">
                        <span class="text-sm font-medium">@sol.EmpleadoNombre</span>
                        <span class="text-xs text-muted-foreground">Empleado</span>
                    </div>
                </div>

                <div class="detail-balance-grid">
                    <div class="mini-card">
                        <span class="mini-card-value tabular-nums">-</span>
                        <span class="mini-card-label">Disponible</span>
                    </div>
                    <div class="mini-card">
                        <span class="mini-card-value tabular-nums">@sol.DiasRequeridos</span>
                        <span class="mini-card-label">Solicitados</span>
                    </div>
                    <div class="mini-card">
                        <span class="mini-card-value tabular-nums">@sol.DiasRequeridos</span>
                        <span class="mini-card-label">Post aprobación</span>
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-row-label">Fecha inicio</span>
                    <span class="detail-row-value">@sol.FechaInicio.ToString("d MMM yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Fecha fin</span>
                    <span class="detail-row-value">@sol.FechaFin.ToString("d MMM yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Días hábiles</span>
                    <span class="detail-row-value tabular-nums">@sol.DiasRequeridos</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Fecha de solicitud</span>
                    <span class="detail-row-value">@sol.CreadoEn.ToString("d MMM yyyy, HH:mm")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Motivo</span>
                    <span class="detail-row-value">@(string.IsNullOrEmpty(sol.Motivo) ? "—" : sol.Motivo)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Comentario</span>
                    <span class="detail-row-value">@(string.IsNullOrEmpty(sol.ComentarioAprobador) ? "—" : sol.ComentarioAprobador)</span>
                </div>
            </div>

            @if (sol.Estado == EstadoSolicitud.Pending)
            {
                <div class="card-footer">
                    <div class="flex items-center gap-2">
                        <a class="btn btn--destructive" asp-action="Rechazar" asp-route-id="@sol.Id">Rechazar</a>
                        <form asp-action="Aprobar" asp-route-id="@sol.Id" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn--default" data-confirm="¿Aprobar esta solicitud?">Aprobar</button>
                        </form>
                    </div>
                </div>
            }
            else if (sol.Estado == EstadoSolicitud.Approved && Model.PuedeCancelarAprobada)
            {
                var folio = "SOL-" + sol.Id.ToString("N").Substring(0, 6).ToUpper();
                <div class="card-footer">
                    <div class="flex flex-col gap-3" id="cancelar-aprobada-block">
                        <div class="rechazo-section" hidden data-cancel-section>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SolicitudId" value="@sol.Id" />
                            <div class="form-group">
                                <label class="form-label form-label--required" for="motivo-cancelacion-detalle">Motivo de la cancelación</label>
                                <textarea id="motivo-cancelacion-detalle" name="Motivo" rows="4" placeholder="Indica el motivo de la cancelación…" required maxlength="500"></textarea>
                                <span class="form-hint"><span id="cancel-char-count-detalle">0</span>/500 caracteres</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="btn btn--destructive"
                                    id="btn-cancelar-aprobada"
                                    data-cancelar-aprobada-detalle="@sol.Id"
                                    data-empleado="@sol.EmpleadoNombre"
                                    data-folio="@folio"
                                    data-fecha-inicio="@sol.FechaInicio.ToString("d MMM yyyy")"
                                    data-fecha-fin="@sol.FechaFin.ToString("d MMM yyyy")">
                                Cancelar solicitud
                            </button>
                            <button type="button" class="btn btn--outline" id="btn-volver-cancelacion-detalle">Cerrar</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Historial de la solicitud</h2>
            </div>
            <div class="card-content">
                @if (sol.Historial.Any())
                {
                    <ol class="timeline">
                        @foreach (var evt in sol.Historial.OrderBy(h => h.Timestamp))
                        {
                            var (icon, cls) = evt.TipoEvento switch
                            {
                                TipoEvento.Created => ("Play", "timeline-marker--created"),
                                TipoEvento.Updated => ("Edit", "timeline-marker--updated"),
                                TipoEvento.Cancelled => ("Slash", "timeline-marker--cancelled"),
                                _ when evt.EstadoNuevo == EstadoSolicitud.Approved => ("UserCheck", "timeline-marker--approved"),
                                _ when evt.EstadoNuevo == EstadoSolicitud.Rejected => ("UserX", "timeline-marker--rejected"),
                                _ when evt.EstadoNuevo == EstadoSolicitud.Cancelled => ("Slash", "timeline-marker--cancelled"),
                                _ => ("Clock", "")
                            };
                            <li class="timeline-item">
                                <span class="timeline-marker @cls">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        @if (icon == "Play")
                                        {
                                            <polygon points="6 3 20 12 6 21 6 3" />
                                        }
                                        else if (icon == "Edit")
                                        {
                                            <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                                        }
                                        else if (icon == "Slash")
                                        {
                                            <circle cx="12" cy="12" r="10" /><path d="m4.9 4.9 14.2 14.2" />
                                        }
                                        else if (icon == "UserCheck")
                                        {
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><polyline points="16 11 18 13 22 9" />
                                        }
                                        else if (icon == "UserX")
                                        {
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="17" x2="22" y1="8" y2="13" /><line x1="22" x2="17" y1="8" y2="13" />
                                        }
                                        else
                                        {
                                            <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                                        }
                                    </svg>
                                </span>
                                <div class="timeline-body">
                                    <span class="text-sm font-medium">@GetEventoLabel(evt)</span>
                                    <span class="text-xs text-muted-foreground">@evt.Actor · @evt.Timestamp.ToString("d MMM yyyy, HH:mm")</span>
                                    @if (!string.IsNullOrEmpty(evt.Comentario))
                                    {
                                        <p>@evt.Comentario</p>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <p class="text-muted-foreground text-sm">No hay eventos registrados.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var btnCancelar = document.getElementById('btn-cancelar-aprobada');
            var cancelSection = document.getElementById('cancelar-aprobada-block').querySelector('[data-cancel-section]');
            var btnVolver = document.getElementById('btn-volver-cancelacion-detalle');
            var textarea = document.getElementById('motivo-cancelacion-detalle');
            var charCount = document.getElementById('cancel-char-count-detalle');
            var tokenInput = document.querySelector('#cancelar-aprobada-block input[name="__RequestVerificationToken"]');

            if (!btnCancelar || !cancelSection || !btnVolver || !textarea) return;

            var modoCancelacion = false;

            function updateState() {
                var hasText = textarea.value.trim().length > 0;
                btnCancelar.disabled = !hasText;
                if (charCount) charCount.textContent = textarea.value.length;
            }

            function salirModoCancelacion() {
                modoCancelacion = false;
                cancelSection.hidden = true;
                textarea.value = '';
                btnCancelar.textContent = 'Cancelar solicitud';
                btnCancelar.disabled = false;
                btnVolver.textContent = 'Cerrar';
                updateState();
            }

            btnCancelar.addEventListener('click', function () {
                if (!modoCancelacion) {
                    modoCancelacion = true;
                    cancelSection.hidden = false;
                    btnCancelar.textContent = 'Confirmar cancelación';
                    btnCancelar.disabled = true;
                    btnVolver.textContent = 'Volver';
                    textarea.focus();
                    updateState();
                    return;
                }

                var motivo = textarea.value.trim();
                if (!motivo) {
                    showToast('El motivo de la cancelación es obligatorio.', 'error');
                    textarea.focus();
                    return;
                }

                var empleado = btnCancelar.getAttribute('data-empleado') || 'el empleado';
                var folio = btnCancelar.getAttribute('data-folio') || '';
                var fechaInicio = btnCancelar.getAttribute('data-fecha-inicio') || '';
                var fechaFin = btnCancelar.getAttribute('data-fecha-fin') || '';

                var detalles = [];
                if (folio) detalles.push(folio);
                if (fechaInicio && fechaFin) detalles.push(fechaInicio + ' – ' + fechaFin);
                var detalleTexto = detalles.length > 0 ? ' (' + detalles.join(' · ') + ')' : '';
                var mensaje = 'Se cancelará la solicitud aprobada de ' + empleado + detalleTexto +
                    '. Motivo: "' + motivo + '". Los días serán devueltos al saldo disponible.';

                if (typeof window.showConfirmDialog !== 'function') {
                    showToast('No se pudo abrir el diálogo de confirmación.', 'error');
                    return;
                }

                window.showConfirmDialog({
                    title: 'Cancelar solicitud',
                    message: mensaje,
                    confirmText: 'Sí, cancelar',
                    cancelText: 'Volver',
                    destructive: true
                }).then(function (confirmed) {
                    if (!confirmed) return;

                    var formData = new FormData();
                    formData.append('id', btnCancelar.getAttribute('data-cancelar-aprobada-detalle'));
                    formData.append('motivo', motivo);
                    if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

                    fetch('/BandejaAprobador/CancelarAprobada', {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                    })
                        .then(function (res) { return res.json(); })
                        .then(function (data) {
                            if (data.ok) {
                                showToast(data.message, 'success');
                                setTimeout(function () { location.reload(); }, 400);
                            } else {
                                showToast(data.message, 'error');
                            }
                        })
                        .catch(function () {
                            showToast('Ocurrió un error. Intente de nuevo.', 'error');
                        });
                });
            });

            btnVolver.addEventListener('click', function (e) {
                if (modoCancelacion) {
                    e.preventDefault();
                    salirModoCancelacion();
                }
            });

            textarea.addEventListener('input', updateState);
        });
    </script>
}

@functions {
    string GetIniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", partes.Select(p => p[0]).Take(2));
    }

    string GetAvatarColor(string nombre)
    {
        var colores = new[] { "f43f5e", "0ea5e9", "8b5cf6", "14b8a6", "f97316", "6366f1", "c026d3" };
        var hash = nombre.Aggregate(0, (acc, c) => acc + c);
        return colores[Math.Abs(hash) % colores.Length];
    }

    string GetEventoLabel(Vacations.Application.Solicitudes.Queries.HistorialEventoDto evt) => evt.TipoEvento switch
    {
        Vacations.Domain.Enums.TipoEvento.Created => "Solicitud creada",
        Vacations.Domain.Enums.TipoEvento.Updated => "Solicitud actualizada",
        Vacations.Domain.Enums.TipoEvento.Cancelled => "Solicitud cancelada",
        _ when evt.EstadoNuevo == EstadoSolicitud.Approved => "Solicitud aprobada",
        _ when evt.EstadoNuevo == EstadoSolicitud.Rejected => "Solicitud rechazada",
        _ when evt.EstadoNuevo == EstadoSolicitud.Cancelled => "Solicitud cancelada",
        _ => "Cambio de estado"
    };
}