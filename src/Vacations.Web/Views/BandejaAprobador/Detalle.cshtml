@model Vacations.Web.ViewModels.AprobarRechazarViewModel
@{
    ViewData["Title"] = "Revisar solicitud";
    var s = Model.Solicitud;
}
<div class="page-header">
    <div>
        <h1 class="page-title">Revisar solicitud</h1>
        <p class="text-muted mono">SOL-@s.Id.ToString("N").Substring(0, 6).ToUpperInvariant()</p>
    </div>
    <span class="status-badge status-badge--@s.Estado">@s.Estado</span>
</div>

<div class="card">
    <div class="card-title">@s.FechaInicio.ToString("dd MMM yyyy") – @s.FechaFin.ToString("dd MMM yyyy")</div>
    <p class="text-sm text-muted">@s.Dias días solicitados</p>
    <p class="mt"><strong>Motivo:</strong> @s.Motivo</p>
    @if (!string.IsNullOrEmpty(s.ComentarioAprobador))
    {
        <p class="mt"><strong>Comentario del aprobador:</strong> @s.ComentarioAprobador</p>
    }
</div>

@if (s.Estado == "Pending")
{
    <div class="card">
        <div class="flex gap">
            <form asp-action="Aprobar" asp-route-id="@s.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn--default">Aprobar</button>
            </form>

            <form asp-action="Rechazar" asp-route-id="@s.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group" style="margin-bottom:8px">
                    <label class="form-label">Comentario (obligatorio para rechazar)</label>
                    <textarea name="Comentario" class="form-textarea" placeholder="Indica el motivo del rechazo…"></textarea>
                </div>
                <button type="submit" class="btn btn--destructive">Rechazar</button>
            </form>
        </div>
    </div>
}
else if (s.Estado == "Approved")
{
    <div class="card">
        <form asp-action="CancelarAprobada" asp-route-id="@s.Id" method="post"
              onsubmit="return confirm('¿Cancelar esta solicitud aprobada? Se devolverá el saldo.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn--destructive">Cancelar aprobada</button>
        </form>
    </div>
}