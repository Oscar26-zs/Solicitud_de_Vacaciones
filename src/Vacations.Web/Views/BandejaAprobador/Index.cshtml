@model BandejaAprobadorViewModel
@{
    ViewData["Title"] = "Bandeja de Aprobación";
    var filtros = new (EstadoSolicitud? Valor, string Texto)[]
    {
        (EstadoSolicitud.Pending, $"Pendientes ({Model.Pendientes})"),
        (EstadoSolicitud.Approved, $"Aprobadas ({Model.Aprobadas})"),
        (EstadoSolicitud.Rejected, $"Rechazadas ({Model.Rechazadas})"),
        (null, $"Todas ({Model.Pendientes + Model.Aprobadas + Model.Rechazadas})")
    };
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div>
            <h1>Bandeja de aprobaciones</h1>
            <p class="page-header--subtitle">Revisa y resuelve las solicitudes de vacaciones de toda la organización.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card">
            <div class="card-content flex items-center gap-4">
                <span class="stat-icon stat-icon--amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                </span>
                <div class="flex flex-col gap-1">
                    <span class="text-sm text-muted-foreground">Pendientes</span>
                    <span class="text-2xl font-semibold tabular-nums">@Model.Pendientes</span>
                    <span class="text-xs text-muted-foreground">Esperan tu decisión</span>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-content flex items-center gap-4">
                <span class="stat-icon stat-icon--emerald">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                </span>
                <div class="flex flex-col gap-1">
                    <span class="text-sm text-muted-foreground">Aprobadas</span>
                    <span class="text-2xl font-semibold tabular-nums">@Model.Aprobadas</span>
                    <span class="text-xs text-muted-foreground">En toda la organización</span>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-content flex items-center gap-4">
                <span class="stat-icon stat-icon--primary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <div class="flex flex-col gap-1">
                    <span class="text-sm text-muted-foreground">Colaboradores</span>
                    <span class="text-2xl font-semibold tabular-nums">@Model.Colaboradores</span>
                    <span class="text-xs text-muted-foreground">Pueden solicitar permisos</span>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-content flex items-center gap-4">
                <span class="stat-icon stat-icon--primary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
                </span>
                <div class="flex flex-col gap-1">
                    <span class="text-sm text-muted-foreground">Días aprobados</span>
                    <span class="text-2xl font-semibold tabular-nums">@Model.DiasAprobados</span>
                    <span class="text-xs text-muted-foreground">Total acumulado</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="flex flex-col gap-1">
                <h2 class="card-title">Solicitudes de vacaciones</h2>
                <p class="text-xs text-muted-foreground">@Model.Pendientes pendiente(s) de revisión</p>
            </div>
        </div>

        <div class="flex flex-col gap-3" style="padding:16px;">
            <form asp-action="Index" method="get" class="filter-row">
                <div class="toggle-group" role="group" aria-label="Filtrar por estado">
                    @foreach (var f in filtros)
                    {
                        if (f.Valor == Model.FiltroEstado)
                        {
                            <a class="toggle-item active" asp-action="Index" asp-route-filtroEmpleado="@Model.FiltroEmpleado" asp-route-estado="@f.Valor">@f.Texto</a>
                        }
                        else
                        {
                            <a class="toggle-item" asp-action="Index" asp-route-filtroEmpleado="@Model.FiltroEmpleado" asp-route-estado="@f.Valor">@f.Texto</a>
                        }
                    }
                </div>
                <div class="search-field" style="flex:1;min-width:200px;">
                    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" name="filtroEmpleado" value="@Model.FiltroEmpleado" placeholder="Buscar por nombre o folio..." />
                </div>
                <button type="submit" class="btn btn--default">Buscar</button>
            </form>
        </div>

        @if (Model.Solicitudes.Any())
        {
            <div class="card-content" style="padding:0;">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Colaborador</th>
                                <th>Periodo</th>
                                <th>Días</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Solicitudes)
                            {
                                var puedeCancelarAprobada = s.Estado == EstadoSolicitud.Approved && s.FechaInicio > Model.FechaActual;
                                <tr onclick="openDetalleAprobacion('@s.Id')">
                                    <td>
                                        <div class="flex items-center gap-3">
                                            @await Html.PartialAsync("_UserAvatar", (AvatarHelper.Iniciales(s.EmpleadoNombre), AvatarHelper.Color(s.EmpleadoNombre)), new ViewDataDictionary(ViewData) { ["AvatarSize"] = "sm" })
                                            <div class="flex flex-col">
                                                <span class="text-sm font-medium">@s.EmpleadoNombre</span>
                                                <span class="text-xs text-muted-foreground">@s.EmpleadoEmail</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@s.FechaInicio.ToString("d MMM yyyy") – @s.FechaFin.ToString("d MMM yyyy")</td>
                                    <td class="tabular-nums">@s.DiasRequeridos</td>
                                    <td>@await Html.PartialAsync("_StatusBadge", s.Estado)</td>
                                    <td onclick="event.stopPropagation()">
                                        <div class="flex items-center gap-2">
                                            <button type="button" class="btn btn--outline btn--sm" data-abrir-detalle="@s.Id">
                                                @if (s.Estado == EstadoSolicitud.Pending)
                                                {
                                                    <text>Revisar</text>
                                                }
                                                else
                                                {
                                                    <text>Ver</text>
                                                }
                                            </button>
                                            @if (puedeCancelarAprobada)
                                            {
                                                <button type="button"
                                                        class="btn btn--destructive btn--sm"
                                                        data-abrir-cancelacion="@s.Id">
                                                    Cancelar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer">
                @await Html.PartialAsync("_TablePagination", new PaginacionViewModel
                {
                    Page = Model.Page,
                    PageSize = Model.PageSize,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    ActionName = "Index",
                    RouteValues = new Dictionary<string, string?>
                    {
                        ["filtroEmpleado"] = Model.FiltroEmpleado,
                        ["estado"] = Model.FiltroEstado?.ToString(),
                        ["fechaDesde"] = Model.FechaDesde?.ToString("yyyy-MM-dd"),
                        ["fechaHasta"] = Model.FechaHasta?.ToString("yyyy-MM-dd")
                    }
                })
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                <h3 class="empty-state-title">No hay solicitudes</h3>
                <p class="empty-state-message">No se encontraron solicitudes con los filtros aplicados.</p>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_DetalleAprobacionDialog")

@section Scripts {
    <script src="~/js/dialog.js" asp-append-version="true" defer></script>
    <script src="~/js/bandeja-aprobador.js" asp-append-version="true" defer></script>
}
