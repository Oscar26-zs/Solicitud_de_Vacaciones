@model EditarSolicitudViewModel
@{
    ViewData["Title"] = "Editar Solicitud";
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div>
            <h1>Editar solicitud</h1>
            <p class="page-header--subtitle">Modifica los datos de la solicitud pendiente.</p>
        </div>
        <a class="btn btn--outline" asp-action="Detalle" asp-route-id="@Model.SolicitudId">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Volver
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="card">
            <form asp-action="Editar" method="post" data-client-validate="true">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SolicitudId" />
                <div class="card-content flex flex-col gap-4">
                    <div asp-validation-summary="ModelOnly" class="text-destructive text-sm mb-3"></div>

                    <div class="form-group">
                        <label asp-for="FechaInicio" class="form-label form-label--required">Fecha de inicio</label>
                        <input asp-for="FechaInicio" type="date" />
                        <span asp-validation-for="FechaInicio"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FechaFin" class="form-label form-label--required">Fecha de fin</label>
                        <input asp-for="FechaFin" type="date" />
                        <span asp-validation-for="FechaFin"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Comentario" class="form-label">Comentario (opcional)</label>
                        <textarea asp-for="Comentario" maxlength="500"></textarea>
                        <span asp-validation-for="Comentario"></span>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="submit" class="btn btn--default">Guardar cambios</button>
                        <a asp-action="Detalle" asp-route-id="@Model.SolicitudId" class="btn btn--outline">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Información</h2>
                <p class="card-description">Solo puedes editar solicitudes pendientes.</p>
            </div>
            <div class="card-content flex flex-col gap-4">
                <div class="detail-balance-grid">
                    <div class="mini-card">
                        <span class="mini-card-value tabular-nums">@Model.SaldoDisponible</span>
                        <span class="mini-card-label">Disponible</span>
                    </div>
                    <div class="mini-card">
                        <span class="mini-card-value tabular-nums">@Model.DiasActuales</span>
                        <span class="mini-card-label">Días actuales</span>
                    </div>
                </div>
                <span class="text-sm text-muted-foreground">
                    Al modificar las fechas se recalcularán los días hábiles.
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}