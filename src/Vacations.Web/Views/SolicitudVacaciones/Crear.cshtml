@model CrearSolicitudViewModel
@{
    ViewData["Title"] = "Nueva Solicitud";
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div>
            <h1>Nueva solicitud</h1>
            <p class="page-header--subtitle">Registra los días que deseas tomar de vacaciones.</p>
        </div>
        <a class="btn btn--outline" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Volver
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="card">
            <form asp-action="Crear" method="post" data-client-validate="true">
                @Html.AntiForgeryToken()
                <div class="card-content flex flex-col gap-4">
                    <div asp-validation-summary="ModelOnly" class="text-destructive text-sm mb-3"></div>

                    <div class="form-group">
                        <label asp-for="FechaInicio" class="form-label form-label--required">Fecha de inicio</label>
                        <input asp-for="FechaInicio" type="date" />
                        <span asp-validation-for="FechaInicio"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FechaFin" class="form-label form-label--required">Fecha de fin</label>
                        <input asp-for="FechaFin" type="date" />
                        <span asp-validation-for="FechaFin"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Comentario" class="form-label">Comentario (opcional)</label>
                        <textarea asp-for="Comentario" maxlength="500" placeholder="Escribe brevemente el motivo de tu solicitud"></textarea>
                        <span asp-validation-for="Comentario"></span>
                        <span class="form-hint">Máximo 500 caracteres.</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="submit" class="btn btn--default">Enviar solicitud</button>
                        <a asp-action="Index" class="btn btn--outline">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Información</h2>
                <p class="card-description">Revisa las reglas antes de enviar tu solicitud.</p>
            </div>
            <div class="card-content flex flex-col gap-4">
                <div class="detail-balance-grid">
                    <div class="mini-card">
                        <span class="mini-card-value tabular-nums">@Model.SaldoDisponible</span>
                        <span class="mini-card-label">Disponible</span>
                    </div>
                </div>

                <div class="separator separator--horizontal"></div>

                <ul class="flex flex-col gap-2 m-0" style="list-style:none;padding:0;font-size:14px;">
                    <li>La fecha de inicio debe ser al menos mañana.</li>
                    <li>El periodo máximo es de 2 meses desde hoy.</li>
                    <li>No puede haber traslape con otras solicitudes activas.</li>
                    <li>Solo se cuentan días hábiles (lunes a viernes).</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}