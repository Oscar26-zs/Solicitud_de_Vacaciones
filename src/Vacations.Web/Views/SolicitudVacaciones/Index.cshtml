@model EmpleadoDashboardViewModel
@{
    ViewData["Title"] = "Mi Saldo";
}

@{
    var estados = new (EstadoSolicitud? Valor, string Texto)[]
    {
        (null, "Todas"),
        (EstadoSolicitud.Pending, "Pendientes"),
        (EstadoSolicitud.Approved, "Aprobadas"),
        (EstadoSolicitud.Rejected, "Rechazadas"),
        (EstadoSolicitud.Cancelled, "Canceladas")
    };
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div>
            <h1 class="text-xl">Hola, @Model.NombreEmpleado.Split(' ')[0]</h1>
            <p class="page-header--subtitle">Consulta tu saldo, registra permisos y da seguimiento a tus solicitudes.</p>
        </div>
        <button type="button" class="btn btn--default" data-sheet-trigger="#sheet-crear">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Crear solicitud
        </button>
    </div>

    @if (Model.Saldo != null)
    {
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="card">
                <div class="card-content flex items-center gap-4">
                    <span class="stat-icon stat-icon--primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                    </span>
                    <div class="flex flex-col gap-1">
                        <span class="text-sm text-muted-foreground">Saldo acumulado</span>
                        <span class="text-2xl font-semibold tabular-nums">@Model.Saldo.SaldoAcumulado</span>
                        <span class="text-xs text-muted-foreground">días</span>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-content flex items-center gap-4">
                    <span class="stat-icon stat-icon--amber">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                    </span>
                    <div class="flex flex-col gap-1">
                        <span class="text-sm text-muted-foreground">Días consumidos</span>
                        <span class="text-2xl font-semibold tabular-nums">@Model.Saldo.SaldoConsumido</span>
                        <span class="text-xs text-muted-foreground">aprobados</span>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-content flex items-center gap-4">
                    <span class="stat-icon stat-icon--emerald">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    </span>
                    <div class="flex flex-col gap-1">
                        <span class="text-sm text-muted-foreground">Saldo disponible</span>
                        <span class="text-2xl font-semibold tabular-nums text-emerald-700">@Model.Saldo.SaldoDisponible</span>
                        <span class="text-xs text-muted-foreground">días</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4" id="dashboard-saldo-grid">
            <div class="card" id="card-saldo-anual" style="grid-column: span 2;">
                <div class="card-header">
                    <h2 class="card-title text-base">Uso del saldo anual</h2>
                </div>
                <div class="card-content flex flex-col gap-2" style="padding-bottom: 0;">
                    <div class="flex items-end justify-between">
                        <span class="text-2xl font-semibold tabular-nums">@Model.Saldo.SaldoConsumido</span>
                        <span class="text-xs text-muted-foreground">de @Model.Saldo.SaldoAcumulado días</span>
                    </div>
                    <div class="progress-track">
                        @{
                            var pct = Model.Saldo.SaldoAcumulado > 0 ? Math.Min(100, (int)Math.Round((double)Model.Saldo.SaldoConsumido / Model.Saldo.SaldoAcumulado * 100)) : 0;
                        }
                        <div class="progress-indicator" style="width: @pct%;"></div>
                    </div>
                    <span class="text-xs text-muted-foreground">
                        Disponibles: <strong class="font-semibold text-emerald-700 tabular-nums">@Model.Saldo.SaldoDisponible</strong>
                        @if (Model.Saldo.SaldoPendiente > 0)
                        {
                            <text> | Pendientes: @Model.Saldo.SaldoPendiente</text>
                        }
                    </span>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2 class="card-title text-base">Resumen</h2>
                </div>
                <div class="card-content flex flex-col gap-0" style="font-size:13px;">
                    <div class="detail-row" style="border-bottom: none; padding: 6px 0;">
                        <span class="detail-row-label">Pendientes</span>
                        <span class="detail-row-value tabular-nums font-semibold text-amber-700">@Model.Pendientes</span>
                    </div>
                    <div class="detail-row" style="border-bottom: none; padding: 6px 0;">
                        <span class="detail-row-label">Aprobadas</span>
                        <span class="detail-row-value tabular-nums font-semibold text-emerald-700">@Model.Aprobadas</span>
                    </div>
                    <div class="detail-row" style="border-bottom: none; padding: 6px 0;">
                        <span class="detail-row-label">Rechazadas</span>
                        <span class="detail-row-value tabular-nums font-semibold text-destructive">@Model.Rechazadas</span>
                    </div>
                    <div class="detail-row" style="border-bottom: none; padding: 6px 0;">
                        <span class="detail-row-label">Canceladas</span>
                        <span class="detail-row-value tabular-nums font-semibold text-muted-foreground">@Model.Canceladas</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="empty-state">
                <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <h3 class="empty-state-title">Aún no tienes saldo</h3>
                <p class="empty-state-message">Tu saldo de vacaciones se acumulará con el tiempo trabajado.</p>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header flex flex-row items-center justify-between">
            <h2 class="card-title">Mis solicitudes</h2>
            <div class="flex items-center gap-2">
                <span class="text-sm text-muted-foreground">Ordenar:</span>
                <select class="form-select" style="width:auto;height:28px;" aria-label="Ordenar solicitudes">
                    <option>Más recientes</option>
                    <option>Más antiguas</option>
                    <option>Por estado</option>
                </select>
            </div>
        </div>

        <div class="toggle-group" role="group" aria-label="Filtrar por estado" style="margin:0 16px;">
            @foreach (var f in estados)
            {
                if (f.Valor == Model.FiltroEstado)
                {
                    <a class="toggle-item active" asp-action="Index">@f.Texto</a>
                }
                else
                {
                    <a class="toggle-item" asp-action="Index" asp-route-estado="@f.Valor">@f.Texto</a>
                }
            }
        </div>

        @if (Model.Solicitudes.Any())
        {
            <div class="card-content" style="padding:0;">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Fechas</th>
                                <th>Días</th>
                                <th>Estado</th>
                                <th>Creada</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Solicitudes)
                            {
                                <tr class="cursor-pointer hover:bg-muted/50 transition-colors" data-solicitud-id="@s.Id" onclick="abrirDetalleModal('@s.Id', event)">
                                    <td class="mono text-xs text-muted-foreground">SOL-@s.Id.ToString("N").Substring(0, 6).ToUpper()</td>
                                    <td>@s.FechaInicio.ToString("d MMM yyyy") – @s.FechaFin.ToString("d MMM yyyy")</td>
                                    <td class="tabular-nums">@s.DiasRequeridos</td>
                                    <td>@await Html.PartialAsync("_StatusBadge", s.Estado)</td>
                                    <td class="text-muted-foreground text-xs">@s.CreadoEn.ToString("d MMM yyyy")</td>
                                    <td onclick="event.stopPropagation()">
                                        <div class="flex items-center gap-1">
                                            <button type="button" class="btn btn--ghost btn--sm" onclick="abrirDetalleModal('@s.Id', event)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                Ver
                                            </button>
                                            @if (s.Estado == EstadoSolicitud.Pending)
                                            {
                                                <a class="btn btn--outline btn--sm" asp-action="Editar" asp-route-id="@s.Id">Editar</a>
                                                <button type="button" class="btn btn--destructive btn--sm" onclick="cancelarSolicitudConConfirmacion('@s.Id', event)">Cancelar</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer">
                @await Html.PartialAsync("_TablePagination", new PaginacionViewModel
                {
                    Page = Model.Page,
                    PageSize = Model.PageSize,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    ActionName = "Index",
                    RouteValues = new Dictionary<string, string?>
                    {
                        ["estado"] = Model.FiltroEstado?.ToString()
                    }
                })
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <h3 class="empty-state-title">No hay solicitudes</h3>
                <p class="empty-state-message">Aún no has creado ninguna solicitud de vacaciones.</p>
                <button type="button" class="btn btn--default" data-sheet-trigger="#sheet-crear">Crear solicitud</button>
            </div>
        }
    </div>
</div>

@if (Model.CrearSolicitud != null)
{
    @await Html.PartialAsync("_SheetCrear", Model.CrearSolicitud, new ViewDataDictionary(ViewData) { ["SheetAbierta"] = Model.SheetAbierta && Model.EditarSolicitud == null })
}
@if (Model.EditarSolicitud != null)
{
    @await Html.PartialAsync("_SheetEditar", Model.EditarSolicitud, new ViewDataDictionary(ViewData) { ["SheetAbierta"] = Model.SheetAbierta })
}

<!-- Modal de Detalle de Solicitud -->
<div id="modal-detalle" class="dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-detalle-title">
    <div class="dialog-content" style="max-width: 600px;">
        <div id="modal-content" class="dialog">
            <!-- El contenido se cargará aquí mediante AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/calendar-range.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Prevenir comportamiento por defecto de formularios con data-confirm (compatibilidad)
            // Este código ahora no se necesita porque los formularios fueron reemplazados
        });

        async function cancelarSolicitudConConfirmacion(solicitudId, event) {
            event?.stopPropagation?.();

            // Abrir modal de confirmación
            const confirmed = await window.showConfirmDialog({
                title: 'Cancelar solicitud',
                message: '¿Estás seguro de que deseas cancelar esta solicitud? Esta acción no se puede deshacer.',
                confirmText: 'Confirmar',
                cancelText: 'Cancelar',
                destructive: true
            });

            if (!confirmed) return;

            try {
                // Ejecutar cancelación vía AJAX POST
                const response = await fetch(`/SolicitudVacaciones/Cancelar?id=${solicitudId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });

                if (!response.ok) {
                    throw new Error('Error al cancelar la solicitud');
                }

                // Recargar la página para actualizar la lista
                window.location.reload();
            } catch (error) {
                console.error(error);
                alert('Error al cancelar la solicitud. Por favor intenta nuevamente.');
            }
        }

        function abrirDetalleModal(solicitudId, event) {
            event?.stopPropagation?.();

            const modal = document.getElementById('modal-detalle');
            const modalContent = document.getElementById('modal-content');

            // Mostrar spinner/loading
            modalContent.innerHTML = '<div class="flex justify-center items-center py-8"><div class="animate-spin h-8 w-8 border-4 border-primary border-t-transparent rounded-full"></div></div>';
            modal.classList.add('dialog-overlay--open');

            // Cargar contenido vía AJAX
            fetch(`/SolicitudVacaciones/DetalleModal?id=${solicitudId}`)
                .then(response => {
                    if (!response.ok) throw new Error('Error al cargar el detalle');
                    return response.text();
                })
                .then(html => {
                    modalContent.innerHTML = html;
                })
                .catch(error => {
                    console.error(error);
                    modalContent.innerHTML = '<div class="text-center py-4"><p class="text-red-500">Error al cargar la solicitud</p><button class="btn btn--outline mt-2" onclick="cerrarDetalleModal()">Cerrar</button></div>';
                });
        }

        function cerrarDetalleModal() {
            const modal = document.getElementById('modal-detalle');
            modal.classList.remove('dialog-overlay--open');
            document.getElementById('modal-content').innerHTML = '';
        }

        // Cerrar modal al presionar ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                cerrarDetalleModal();
            }
        });

        // Cerrar modal al hacer clic en el overlay
        document.getElementById('modal-detalle').addEventListener('click', function (e) {
            if (e.target === this) {
                cerrarDetalleModal();
            }
        });

        // Manejar submit del formulario de crear solicitud vía AJAX
        document.addEventListener('DOMContentLoaded', function () {
            const formCrear = document.getElementById('form-crear-solicitud');
            if (formCrear) {
                formCrear.addEventListener('submit', function (e) {
                    e.preventDefault();

                    // Validar clientside
                    if (!formCrear.checkValidity()) {
                        formCrear.reportValidity();
                        return;
                    }

                    // Crear FormData con el contenido del formulario
                    const formData = new FormData(formCrear);

                    // Enviar vía AJAX
                    fetch('/SolicitudVacaciones/Crear', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(function (response) {
                            var contentType = response.headers.get('Content-Type') || '';
                            if (contentType.indexOf('application/json') !== -1) {
                                return response.json();
                            }
                            // El servidor devolvió la vista con errores de validación: recargar para mostrarlos
                            window.location.reload();
                            return null;
                        })
                        .then(function (data) {
                            if (!data) return;

                            if (data.success) {
                                // Cerrar el sheet de crear
                                const sheet = formCrear.closest('.sheet-container');
                                if (sheet) {
                                    sheet.classList.remove('sheet-container--open');
                                    sheet.querySelector('.sheet-overlay').classList.remove('sheet-overlay--open');
                                    sheet.querySelector('.sheet').classList.remove('sheet--open');
                                }

                                // Abrir el modal de detalle con la solicitud recién creada
                                setTimeout(() => {
                                    abrirDetalleModal(data.solicitudId);
                                }, 300);
                            } else {
                                showToast(data.error || 'No se pudo crear la solicitud.', 'error');
                            }
                        })
                        .catch(error => {
                            console.error(error);
                            showToast('Ocurrió un error al crear la solicitud. Intente de nuevo.', 'error');
                        });
                });
            }
        });
    </script>
    @* TODO: Reemplazar confirm() nativo por modal destructivo (_ConfirmDialog.cshtml) según DESIGN_TOKENS.md.
       El patrón correcto: interceptar submit → abrir modal → fetch POST a /Cancelar → showToast() → reload. *@
}
