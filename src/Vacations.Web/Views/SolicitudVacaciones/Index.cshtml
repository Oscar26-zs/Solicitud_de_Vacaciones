@model SolicitudListaViewModel
@{
    ViewData["Title"] = "Mis Solicitudes";
}

@{
    var estados = new (EstadoSolicitud? Valor, string Texto)[]
    {
        (null, "Todas"),
        (EstadoSolicitud.Pending, "Pendientes"),
        (EstadoSolicitud.Approved, "Aprobadas"),
        (EstadoSolicitud.Rejected, "Rechazadas"),
        (EstadoSolicitud.Cancelled, "Canceladas")
    };
}

<div class="flex flex-col gap-6">
    <div class="card">
        <div class="card-header flex flex-row items-center justify-between">
            <h2 class="card-title">Mis solicitudes</h2>
            <div class="flex items-center gap-2">
                <span class="text-sm text-muted-foreground">Ordenar:</span>
                <select class="form-select" style="width:auto;height:28px;" aria-label="Ordenar solicitudes">
                    <option>Más recientes</option>
                    <option>Más antiguas</option>
                    <option>Por estado</option>
                </select>
            </div>
        </div>

        <div class="toggle-group" role="group" aria-label="Filtrar por estado" style="margin:0 16px;">
            @foreach (var f in estados)
            {
                if (f.Valor == Model.FiltroEstado)
                {
                    <a class="toggle-item active" asp-action="Index">@f.Texto</a>
                }
                else
                {
                    <a class="toggle-item" asp-action="Index" asp-route-estado="@f.Valor">@f.Texto</a>
                }
            }
        </div>

        @if (Model.Solicitudes.Any())
        {
            <div class="card-content" style="padding:0;">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Fechas</th>
                                <th>Días</th>
                                <th>Estado</th>
                                <th>Creada</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Solicitudes)
                            {
                                <tr onclick="location.href='@Url.Action("Detalle", new { id = s.Id })'">
                                    <td class="mono text-xs text-muted-foreground">SOL-@s.Id.ToString("N").Substring(0, 6).ToUpper()</td>
                                    <td>@s.FechaInicio.ToString("d MMM yyyy") – @s.FechaFin.ToString("d MMM yyyy")</td>
                                    <td class="tabular-nums">@s.DiasRequeridos</td>
                                    <td>@await Html.PartialAsync("_StatusBadge", s.Estado)</td>
                                    <td class="text-muted-foreground text-xs">@s.CreadoEn.ToString("d MMM yyyy")</td>
                                    <td>
                                        <div class="flex items-center gap-1" onclick="event.stopPropagation()">
                                            <a class="btn btn--ghost btn--sm" asp-action="Detalle" asp-route-id="@s.Id">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                Ver
                                            </a>
                                            @if (s.Estado == EstadoSolicitud.Pending)
                                            {
                                                <a class="btn btn--outline btn--sm" asp-action="Editar" asp-route-id="@s.Id">Editar</a>
                                                <form asp-action="Cancelar" asp-route-id="@s.Id" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn--destructive btn--sm" data-confirm="¿Está seguro de cancelar esta solicitud?">Cancelar</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer">
                <div class="flex flex-col gap-4">
                    @await Html.PartialAsync("_TablePagination", new PaginacionViewModel
                    {
                        Page = Model.Page,
                        PageSize = Model.PageSize,
                        TotalPages = Model.TotalPages,
                        TotalCount = Model.TotalCount,
                        ActionName = "Index"
                    })
                    <a class="btn btn--default btn--full" asp-action="Crear">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        Crear solicitud
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <h3 class="empty-state-title">No hay solicitudes</h3>
                <p class="empty-state-message">Aún no has creado ninguna solicitud de vacaciones.</p>
                <a class="btn btn--default" asp-action="Crear">Crear solicitud</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', function () { document.querySelectorAll('[data-confirm]').forEach(function (btn) { btn.closest('form').addEventListener('submit', function (e) { if (!confirm(btn.getAttribute('data-confirm'))) e.preventDefault(); }); }); });</script>
}