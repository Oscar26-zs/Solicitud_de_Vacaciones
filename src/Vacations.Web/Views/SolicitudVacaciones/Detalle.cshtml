@model SolicitudDetalleViewModel
@using Vacations.Domain.Enums
@{
    ViewData["Title"] = "Detalle de Solicitud";
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div class="flex items-center gap-3">
            <h1 class="mono">SOL-@Model.Id.ToString("N").Substring(0, 6).ToUpper()</h1>
            @await Html.PartialAsync("_StatusBadge", Model.Estado)
        </div>
        <a class="btn btn--outline" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Volver
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Información de la solicitud</h2>
            </div>
            <div class="card-content flex flex-col gap-4">
                <div class="flex items-center gap-3">
                    @await Html.PartialAsync("_UserAvatar", (GetIniciales(Model.NombreEmpleado), GetAvatarColor(Model.NombreEmpleado)), new ViewDataDictionary(ViewData) { ["AvatarSize"] = "lg" })
                    <div class="flex flex-col">
                        <span class="text-sm font-medium">@Model.NombreEmpleado</span>
                        <span class="text-xs text-muted-foreground">Empleado</span>
                    </div>
                </div>

                <div class="detail-balance-grid">
                    <div class="mini-card">
                        <span class="mini-card-value tabular-nums">@Model.DiasHabiles</span>
                        <span class="mini-card-label">Solicitados</span>
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-row-label">Fecha inicio</span>
                    <span class="detail-row-value">@Model.FechaInicio.ToString("d MMM yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Fecha fin</span>
                    <span class="detail-row-value">@Model.FechaFin.ToString("d MMM yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Días hábiles</span>
                    <span class="detail-row-value tabular-nums">@Model.DiasHabiles</span>
                </div>
                <div class="detail-row">
                    <span class="detail-row-label">Fecha de solicitud</span>
                    <span class="detail-row-value">@Model.FechaCreacion.ToString("d MMM yyyy, HH:mm")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Comentario))
                {
                    <div class="detail-row">
                        <span class="detail-row-label">Motivo</span>
                        <span class="detail-row-value">@Model.Comentario</span>
                    </div>
                }
            </div>

            @if (Model.PuedeEditar || Model.PuedeCancelar || Model.PuedeCancelarAprobada)
            {
                <div class="card-footer">
                    <div class="flex items-center gap-2 flex-wrap">
                        @if (Model.PuedeEditar)
                        {
                            <a class="btn btn--outline" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
                        }
                        @if (Model.PuedeCancelar)
                        {
                            <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn--destructive" data-confirm="¿Está seguro de cancelar esta solicitud?">Cancelar solicitud</button>
                            </form>
                        }
                        @if (Model.PuedeCancelarAprobada)
                        {
                            <form asp-action="CancelarAprobada" asp-route-id="@Model.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn--destructive" data-confirm="¿Cancelar esta solicitud aprobada? Solo es posible si aún no inició el periodo.">Cancelar solicitud aprobada</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Historial</h2>
            </div>
            <div class="card-content">
                @if (Model.Historial.Any())
                {
                    <ol class="timeline">
                        @foreach (var evt in Model.Historial.OrderBy(h => h.Timestamp))
                        {
                            var (icon, cls) = evt.TipoEvento switch
                            {
                                TipoEvento.Created => ("Play", "timeline-marker--created"),
                                TipoEvento.Updated => ("Edit", "timeline-marker--updated"),
                                TipoEvento.Cancelled => ("Slash", "timeline-marker--cancelled"),
                                _ when evt.EstadoNuevo == EstadoSolicitud.Approved => ("UserCheck", "timeline-marker--approved"),
                                _ when evt.EstadoNuevo == EstadoSolicitud.Rejected => ("UserX", "timeline-marker--rejected"),
                                _ => ("Clock", "")
                            };

                            <li class="timeline-item">
                                <span class="timeline-marker @cls">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        @if (icon == "Play")
                                        {
                                            <polygon points="6 3 20 12 6 21 6 3" />
                                        }
                                        else if (icon == "Edit")
                                        {
                                            <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                                        }
                                        else if (icon == "Slash")
                                        {
                                            <circle cx="12" cy="12" r="10" /><path d="m4.9 4.9 14.2 14.2" />
                                        }
                                        else if (icon == "UserCheck")
                                        {
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><polyline points="16 11 18 13 22 9" />
                                        }
                                        else if (icon == "UserX")
                                        {
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="17" x2="22" y1="8" y2="13" /><line x1="22" x2="17" y1="8" y2="13" />
                                        }
                                        else
                                        {
                                            <circle cx="12" cy="12" r="1" />
                                        }
                                    </svg>
                                </span>
                                <span class="text-sm">
                                    <span class="font-medium block">@GetEventoLabel(evt)</span>
                                    <span class="text-muted-foreground text-xs">@evt.Timestamp.ToString("d MMM yyyy, HH:mm")</span>
                                </span>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <p class="text-sm text-muted-foreground text-center py-4">Sin historial</p>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetIniciales(string nombre)
    {
        if (string.IsNullOrEmpty(nombre)) return "?";
        var partes = nombre.Split(' ');
        return partes.Length > 1 
            ? $"{partes[0][0]}{partes[1][0]}" 
            : $"{partes[0][0]}";
    }

    private string GetAvatarColor(string nombre)
    {
        var hash = nombre.GetHashCode();
        var colors = new[] { "e74c3c", "3498db", "2ecc71", "f39c12", "9b59b6", "1abc9c", "e67e22", "34495e" };
        return colors[Math.Abs(hash) % colors.Length];
    }

    private string GetEventoLabel(Vacations.Application.Solicitudes.Queries.HistorialEventoDto evt) => 
        evt.TipoEvento switch
        {
            TipoEvento.Created => "Solicitud creada",
            TipoEvento.Updated => "Solicitud actualizada",
            TipoEvento.Cancelled => "Solicitud cancelada",
            _ when evt.EstadoNuevo == EstadoSolicitud.Approved => "Solicitud aprobada",
            _ when evt.EstadoNuevo == EstadoSolicitud.Rejected => "Solicitud rechazada",
            _ => "Cambio de estado"
        };
}
