@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}
<div class="login-wrap">
    <div class="login-top">
        <a class="app-logo" asp-controller="Home" asp-action="Index" aria-label="PermisosApp">
            <span class="app-logo-mark app-logo-mark--lg">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
            </span>
            <span class="app-logo-text">
                <span class="app-logo-name">PermisosApp</span>
                <span class="app-logo-subtitle">Permisos y Vacaciones</span>
            </span>
        </a>
        @await Html.PartialAsync("_ThemeToggle")
    </div>

    <div class="login-center">
        <span class="badge badge--secondary">Demo interactivo</span>
        <h1 class="login-title">Gestión de Permisos y Vacaciones</h1>
        <p class="login-subtitle">Inicia sesión para consultar tu saldo y gestionar tus solicitudes.</p>

        <div class="card login-card">
            <form asp-action="Login" method="post" data-client-validate="true" class="flex flex-col gap-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert--destructive" role="alert">
                        <svg class="alert-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                        <div class="alert-content">
                            <strong class="alert-title">No se pudo iniciar sesión</strong>
                            <p class="alert-message">@ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage</p>
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label asp-for="Email" class="form-label form-label--required">Correo electrónico</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label form-label--required">Contraseña</label>
                    <div class="password-field">
                        <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" data-password-input />
                        <button type="button" class="password-toggle" data-password-toggle aria-label="Mostrar contraseña">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>

                <label class="flex items-center gap-2 cursor-pointer select-none" style="font-size:14px;">
                    <input asp-for="RememberMe" type="checkbox" style="width:16px;height:16px;" />
                    <span>Recordarme</span>
                </label>

                <button type="submit" class="btn btn--default btn--full">Iniciar sesión</button>
            </form>

            <div class="demo-credentials">
                <p class="demo-credentials-title">Cuentas demo</p>
                <button type="button" class="demo-credential" data-fill-email="empleado@example.com" data-fill-password="Empleado123!">
                    <span class="demo-credential-name">Empleado</span>
                    <span class="demo-credential-pw">empleado@example.com / Empleado123!</span>
                </button>
                <button type="button" class="demo-credential" data-fill-email="aprobador@example.com" data-fill-password="Aprobador123!">
                    <span class="demo-credential-name">Aprobador</span>
                    <span class="demo-credential-pw">aprobador@example.com / Aprobador123!</span>
                </button>
                <button type="button" class="demo-credential" data-fill-email="rrhh@example.com" data-fill-password="Rrhh123!">
                    <span class="demo-credential-name">RRHH</span>
                    <span class="demo-credential-pw">rrhh@example.com / Rrhh123!</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            document.addEventListener('DOMContentLoaded', function () {
                var toggle = document.querySelector('[data-password-toggle]');
                var passwordInput = document.querySelector('[data-password-input]');
                if (toggle && passwordInput) {
                    toggle.addEventListener('click', function () {
                        var isPassword = passwordInput.type === 'password';
                        passwordInput.type = isPassword ? 'text' : 'password';
                        toggle.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
                    });
                }

                document.querySelectorAll('[data-fill-email]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var email = btn.getAttribute('data-fill-email');
                        var password = btn.getAttribute('data-fill-password');
                        var emailInput = document.querySelector('#Email');
                        var passInput = document.querySelector('#Password');
                        if (emailInput) emailInput.value = email;
                        if (passInput) passInput.value = password;
                        emailInput.setAttribute('aria-invalid', 'false');
                        passInput.setAttribute('aria-invalid', 'false');
                    });
                });
            });
        })();
    </script>
}