<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vacaciones</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
    <div class="app-shell">
        <header class="app-header">
            <div class="app-header-inner">
                <a class="app-brand" asp-controller="SolicitudVacaciones" asp-action="Index">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
                    <span class="app-brand-text">Vacaciones</span>
                </a>

                <nav class="app-nav">
                    <a class="app-nav-link" asp-controller="SolicitudVacaciones" asp-action="Index">Mis solicitudes</a>
                    <a class="app-nav-link" asp-controller="Saldo" asp-action="Index">Mi saldo</a>
                    @if (User.IsInRole("Aprobador"))
                    {
                        <a class="app-nav-link" asp-controller="BandejaAprobador" asp-action="Index">Bandeja</a>
                    }
                    @if (User.IsInRole("RRHH"))
                    {
                        <a class="app-nav-link" asp-controller="RRHH" asp-action="Solicitudes">RRHH</a>
                    }
                </nav>

                <div class="app-header-actions">
                    <button class="theme-toggle" data-theme-toggle aria-label="Cambiar tema" type="button">
                        <svg class="theme-toggle-icon theme-toggle-icon--light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                        <svg class="theme-toggle-icon theme-toggle-icon--dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @await Component.InvokeAsync("UserMenu")
                    }
                    else
                    {
                        <a class="btn btn--default" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                    }
                </div>
            </div>
        </header>

        <main class="app-main">
            @if (TempData["Exito"] is string exito)
            {
                <div class="alert alert--success">
                    <svg class="alert-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div class="alert-content"><p class="alert-message">@exito</p></div>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert--destructive">
                    <svg class="alert-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                    <div class="alert-content"><p class="alert-message">@error</p></div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>