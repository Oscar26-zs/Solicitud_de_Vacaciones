@{
    ViewData["Title"] = "Empleado no vinculado";
}

<div class="empty-state">
    <div class="empty-state__icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
        </svg>
    </div>
    <h2 class="empty-state__title">Tu usuario no está vinculado a un empleado</h2>
    <p class="empty-state__text">
        Para acceder a esta sección necesitas que un administrador vincule tu cuenta
        con un registro de empleado en el sistema. Contacta al área de Recursos Humanos
        para completar la vinculación.
    </p>
    <a class="btn btn--default" asp-controller="SolicitudVacaciones" asp-action="Index">Reintentar</a>
</div>
