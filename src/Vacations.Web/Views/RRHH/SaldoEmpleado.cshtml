@model SaldoViewModel
@{
    ViewData["Title"] = "Saldo del Empleado";
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div>
            <h1>Saldo del empleado</h1>
            <p class="page-header--subtitle">@Model.NombreEmpleado</p>
        </div>
        <a class="btn btn--outline" asp-action="Solicitudes">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Volver
        </a>
    </div>

    @if (Model.Saldo != null)
    {
        <div class="card">
            <div class="card-header flex flex-row items-center gap-3">
                @await Html.PartialAsync("_UserAvatar", (GetIniciales(Model.NombreEmpleado), GetAvatarColor(Model.NombreEmpleado)), new ViewDataDictionary(ViewData) { ["AvatarSize"] = "lg" })
                <h2 class="card-title">@Model.NombreEmpleado</h2>
            </div>
            <div class="card-content">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <div class="card">
                        <div class="card-content flex items-center gap-4">
                            <span class="stat-icon stat-icon--primary">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                            </span>
                            <div class="flex flex-col gap-1">
                                <span class="text-sm text-muted-foreground">Acumulado</span>
                                <span class="text-2xl font-semibold tabular-nums">@Model.Saldo.SaldoAcumulado</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-content flex items-center gap-4">
                            <span class="stat-icon stat-icon--amber">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                            </span>
                            <div class="flex flex-col gap-1">
                                <span class="text-sm text-muted-foreground">Consumido</span>
                                <span class="text-2xl font-semibold tabular-nums">@Model.Saldo.SaldoConsumido</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-content flex items-center gap-4">
                            <span class="stat-icon stat-icon--emerald">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                            </span>
                            <div class="flex flex-col gap-1">
                                <span class="text-sm text-muted-foreground">Disponible</span>
                                <span class="text-2xl font-semibold tabular-nums text-emerald-700">@Model.Saldo.SaldoDisponible</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="separator separator--horizontal" style="margin:16px 0;"></div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" style="font-size:14px;">
                    <div class="detail-row">
                        <span class="detail-row-label">Acumulado</span>
                        <span class="detail-row-value tabular-nums">@Model.Saldo.SaldoAcumulado días</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Consumido</span>
                        <span class="detail-row-value tabular-nums">@Model.Saldo.SaldoConsumido días</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Pendiente</span>
                        <span class="detail-row-value tabular-nums">@Model.Saldo.SaldoPendiente días</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="empty-state">
                <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <h3 class="empty-state-title">Sin saldo</h3>
                <p class="empty-state-message">Este empleado no tiene saldo de vacaciones registrado.</p>
            </div>
        </div>
    }
</div>

@functions {
    string GetIniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", partes.Select(p => p[0]).Take(2));
    }

    string GetAvatarColor(string nombre)
    {
        var colores = new[] { "f43f5e", "0ea5e9", "8b5cf6", "14b8a6", "f97316", "6366f1", "c026d3" };
        var hash = nombre.Aggregate(0, (acc, c) => acc + c);
        return colores[Math.Abs(hash) % colores.Length];
    }
}