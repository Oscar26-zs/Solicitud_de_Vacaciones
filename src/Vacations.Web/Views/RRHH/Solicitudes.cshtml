@model ConsultaRRHHViewModel
@{
    ViewData["Title"] = "Consultas RRHH";
}

<div class="flex flex-col gap-6">
    <div class="page-header">
        <div>
            <h1>Historial de solicitudes</h1>
            <p class="page-header--subtitle">Consulta y exporta las solicitudes de todos los colaboradores.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-content" style="padding:16px;">
            <form asp-action="Solicitudes" method="get" class="filter-row">
                <div class="search-field" style="flex:1;min-width:200px;">
                    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" name="empleadoId" value="@Model.FiltroEmpleadoId" placeholder="Buscar por ID de empleado..." />
                </div>
                <select name="estado" asp-items="@(Html.GetEnumSelectList<EstadoSolicitud>())" style="flex:1;min-width:150px;">
                    <option value="">Todos los estados</option>
                </select>
                <div class="flex items-center gap-2">
                    <input type="date" name="fechaDesde" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" aria-label="Desde" />
                    <input type="date" name="fechaHasta" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" aria-label="Hasta" />
                </div>
                <button type="submit" class="btn btn--default">Filtrar</button>
                <a class="btn btn--outline" asp-action="Solicitudes">Limpiar</a>
            </form>
        </div>

        @if (Model.Solicitudes.Any())
        {
            <div class="card-content" style="padding:0;">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Colaborador</th>
                                <th>Folio</th>
                                <th>Periodo</th>
                                <th>Días</th>
                                <th>Estado</th>
                                <th>Creada</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Solicitudes)
                            {
                                <tr onclick="location.href='@Url.Action("SaldoEmpleado", new { empleadoId = s.EmpleadoId })'">
                                    <td>
                                        <div class="flex items-center gap-3">
                                            @await Html.PartialAsync("_UserAvatar", (GetIniciales(s.EmpleadoNombre), GetAvatarColor(s.EmpleadoNombre)), new ViewDataDictionary(ViewData) { ["AvatarSize"] = "sm" })
                                            <div class="flex flex-col">
                                                <span class="text-sm font-medium">@s.EmpleadoNombre</span>
                                                <span class="text-xs text-muted-foreground">@s.EmpleadoEmail</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="mono text-xs text-muted-foreground">SOL-@s.Id.ToString("N").Substring(0, 6).ToUpper()</td>
                                    <td>@s.FechaInicio.ToString("d MMM yyyy") – @s.FechaFin.ToString("d MMM yyyy")</td>
                                    <td class="tabular-nums">@s.DiasRequeridos</td>
                                    <td>@await Html.PartialAsync("_StatusBadge", s.Estado)</td>
                                    <td class="text-muted-foreground text-xs">@s.CreadoEn.ToString("d MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer">
                <div class="flex items-center justify-between gap-4 flex-wrap">
                    <span class="text-sm text-muted-foreground">
                        <strong class="font-medium tabular-nums">@Model.TotalCount</strong> registros
                    </span>
                    <div class="flex items-center gap-2">
                        <button type="button" class="btn btn--outline btn--sm" data-export-csv>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                            Exportar CSV
                        </button>
                    </div>
                </div>
                @await Html.PartialAsync("_TablePagination", new PaginacionViewModel
                {
                    Page = Model.Page,
                    PageSize = Model.PageSize,
                    SelectedPageSize = Model.PageSize,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    ActionName = "Solicitudes",
                    RouteValues = new Dictionary<string, string?>
                    {
                        ["empleadoId"] = Model.FiltroEmpleadoId?.ToString(),
                        ["estado"] = Model.FiltroEstado?.ToString(),
                        ["fechaDesde"] = Model.FechaDesde?.ToString("yyyy-MM-dd"),
                        ["fechaHasta"] = Model.FechaHasta?.ToString("yyyy-MM-dd")
                    }
                })
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <h3 class="empty-state-title">Sin resultados</h3>
                <p class="empty-state-message">No se encontraron solicitudes con los filtros aplicados.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelector('[data-export-csv]')?.addEventListener('click', function () {
                var rows = [];
                document.querySelectorAll('.table tbody tr').forEach(function (tr) {
                    var cells = [];
                    tr.querySelectorAll('td').forEach(function (td, i) {
                        if (i >= 3) return;
                        cells.push(td.textContent.trim().replace(/,/g, ' '));
                    });
                    cells.push(tr.querySelectorAll('td')[4].textContent.trim());
                    rows.push(cells.join(','));
                });
                var csv = '\uFEFFEmpleado,Periodo,Dias,Estado\n' + rows.join('\n');
                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'solicitudes.csv';
                a.click();
                URL.revokeObjectURL(url);
            });
        });
    </script>
}

@functions {
    string GetIniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", partes.Select(p => p[0]).Take(2));
    }

    string GetAvatarColor(string nombre)
    {
        var colores = new[] { "f43f5e", "0ea5e9", "8b5cf6", "14b8a6", "f97316", "6366f1", "c026d3" };
        var hash = nombre.Aggregate(0, (acc, c) => acc + c);
        return colores[Math.Abs(hash) % colores.Length];
    }
}